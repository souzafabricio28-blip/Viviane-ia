# API Principal (groq, gemini, ollama, openai, fallback, auto)
# openai = endpoint local/custom compatível com OpenAI (ex: http://localhost:20128/v1)
# fallback/auto = tenta provedores configurados automaticamente se um falhar
AI_PROVIDER=fallback

# Endpoint local/custom compatível com OpenAI (Chat Completions)
# Ex.: http://localhost:20128/v1
OPENAI_BASE_URL=
# Chave/token se o endpoint exigir (Authorization: Bearer)
OPENAI_API_KEY=
# ID do modelo; se vazio, tenta detectar via /v1/models
OPENAI_MODEL=

# Chave da API Groq (recomendado - https://console.groq.com)
GROQ_API_KEY=

# Chave da API Google Gemini (opcional - https://aistudio.google.com)
GEMINI_API_KEY=

# Modelo e URL do Ollama (usado quando AI_PROVIDER=ollama ou como fallback final)
OLLAMA_MODEL=llama3
OLLAMA_URL=http://localhost:11434

# Idioma padrão (pt-BR ou en-US)
LANGUAGE=pt-BR

# Nome do assistente
ASSISTANT_NAME=Viviane

# Nome do usuário (para saudação personalizada)
USER_NAME=Usuario

# API Weather (opcional - https://openweathermap.org/api)
WEATHER_API_KEY=

# API News (opcional - https://newsapi.org)
NEWS_API_KEY=

# Motor TTS: "edge" (neural, recomendado) ou "sapi" (Windows)
TTS_ENGINE=edge
# Voz feminina: pt-BR-ThalitaMultilingualNeural
TTS_VOICE=pt-BR-ThalitaMultilingualNeural

# Microfone sempre ligado: diga "Viviane" e fale o pedido (sem apertar nada)
VIVIANE_MIC_ATIVO=true

# Modo local: a Viviane só escuta em 127.0.0.1. Mantenha true.
LOCAL_ONLY=true

# Painel web opcional, sempre neste computador
VIVIANE_HOST=127.0.0.1
VIVIANE_PORT=5000

# Wake Word (palavra gatilho)
WAKE_WORD=oi vivi
WAKE_WORD_ENGINE=simple
WAKE_WORD_SENSITIVITY=0.6

# API Replicate (para geração de imagens - https://replicate.com)
REPLICATE_API_KEY=
# Painel web opcional na janela (só 127.0.0.1). Padrão: desligado.
ENABLE_LOCAL_WEB=false

# Permite ações sensíveis no sistema (comandos, desligar, processos, registro)
ALLOW_SYSTEM_ACTIONS=true
